# Copy to .env and adjust. Never commit .env.

# Used by docker-compose for the local Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Password
POSTGRES_DB=webhooks
POSTGRES_HOST_PORT=5433
API_PORT=8000

# Used by the API and worker when run outside docker-compose (or in the cloud).
# postgres:// and postgresql:// URLs are accepted and converted to the psycopg driver.
DATABASE_URL=postgresql+psycopg://postgres:Password@localhost:5433/webhooks

PROCESSING_DELAY_SECONDS=30
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=5

# Tests (pytest) use a separate database, created automatically if missing
TEST_DATABASE_URL=postgresql+psycopg://postgres:Password@localhost:5433/webhooks_test
